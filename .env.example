# Copy to .env.local and fill in. Every key is optional: tools degrade gracefully without them.

# Public site URL (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://lemy.ai
# Where every "Want us to fix this?" CTA points
NEXT_PUBLIC_SCRIPT_COMMERCE_URL=https://scriptcommerce.com
NEXT_PUBLIC_SCRIPT_COMMERCE_CONTACT_URL=https://scriptcommerce.com/contact

# Google PageSpeed Insights API key (free). Without it Google's shared quota often returns 429.
# https://developers.google.com/speed/docs/insights/v5/get-started#APIKey
PSI_API_KEY=

# LLM: any OpenAI-compatible Chat Completions endpoint with vision + JSON output
# (OpenAI, OpenRouter, Gemini's OpenAI-compatible endpoint, Azure, ...)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Optional, only for reasoning models (e.g. "minimal" or "low"). Leave empty otherwise.
LLM_REASONING_EFFORT=

# Screenshots for the PDP CRO Audit. ScreenshotOne is used if set, otherwise Microlink (free tier, key optional).
SCREENSHOTONE_ACCESS_KEY=
MICROLINK_API_KEY=

# Abuse and cost protection
RATE_LIMIT_RUNS=8
RATE_LIMIT_WINDOW_MINUTES=10
AI_DAILY_CALL_CAP=300

# Email gate. Leads are POSTed to the webhook (Google Sheets Apps Script, Zapier, Make, n8n...)
# and also appended to .data/leads.jsonl when the filesystem is writable (local dev).
LEADS_WEBHOOK_URL=
# Protects GET /api/leads?key=...&format=csv
LEADS_ADMIN_KEY=
